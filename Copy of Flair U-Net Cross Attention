 print(\"Existing split found in Drive. Loading it.\")\n","    with open(split_path, \"r\") as f:\n","        split = json.load(f)\n","\n","    train_ids = [\n","        x for x in split[\"train\"]\n","        if x in patient_ids\n","    ]\n","\n","    val_ids = [\n","        x for x in split[\"validation\"]\n","        if x in patient_ids\n","    ]\n","\n","    test_ids = [\n","        x for x in split[\"test\"]\n","        if x in patient_ids\n","    ]\n","\n","else:\n","    print(\"Creating new deterministic split.\")\n","\n","    rng = np.random.default_rng(SEED)\n","    shuffled_ids = patient_ids.copy()\n","    rng.shuffle(shuffled_ids)\n","\n","    total = len(shuffled_ids)\n","\n","    if total >= 369:\n","        train_count = 258\n","        val_count = 55\n","        test_count = total - train_count - val_count\n","    else:\n","        train_count = int(total * 0.70)\n","        val_count = int(total * 0.15)\n","        test_count = total - train_count - val_count\n","\n","    train_ids = sorted(\n","        shuffled_ids[:train_count]\n","    )\n","\n","    val_ids = sorted(\n","        shuffled_ids[train_count:train_count + val_count]\n","    )\n","\n","    test_ids = sorted(\n","        shuffled_ids[train_count + val_count:]\n","    )\n","\n","    split = {\n","        \"train\": train_ids,\n","        \"validation\": val_ids,\n","        \"test\": test_ids,\n","    }\n","\n","    with open(split_path, \"w\") as f:\n","        json.dump(split, f, indent=2)\n","\n","print(\"Train patients:\", len(train_ids))\n","print(\"Validation patients:\", len(val_ids))\n","print(\"Test patients:\", len(test_ids))\n","\n","assert len(set(train_ids) & set(val_ids)) == 0\n","assert len(set(train_ids) & set(test_ids)) == 0\n","assert len(set(val_ids) & set(test_ids)) == 0\n","\n","with open(RESULTS_DIR / \"patient_split_colab.json\", \"w\") as f:\n","    json.dump(\n","        {\n","            \"train\": train_ids,\n","            \"validation\": val_ids,\n","            \"test\": test_ids,\n","        },\n","        f,\n","        indent=2,\n","    )"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ZBvYdjszQYOK","executionInfo":{"status":"ok","timestamp":1783410021931,"user_tz":-330,"elapsed":13,"user":{"displayName":"","userId":""}},"outputId":"f0837312-5c15-4a8e-ec0f-5d425abf7d9a"},"id":"ZBvYdjszQYOK","execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["Existing split found in Drive. Loading it.\n","Train patients: 257\n","Validation patients: 55\n","Test patients: 56\n"]}]},{"cell_type":"code","source":["# Cell 4 — Preprocess FLAIR-only MRI into 2D slices\n","\n","patient_dir_map = {\n","    p.name: p\n","    for p in patient_dirs\n","}\n","\n","\n","def find_file(patient_dir, suffix):\n","    patient_dir = Path(patient_dir)\n","\n","    matches = (\n","        list(patient_dir.glob(f\"*_{suffix}.nii\"))\n","        + list(patient_dir.glob(f\"*_{suffix}.nii.gz\"))\n","    )\n","\n","    if len(matches) == 0:\n","        raise FileNotFoundError(\n","            f\"No {suffix} file found in {patient_dir}\"\n","        )\n","\n","    return matches[0]\n","\n","\n","def normalize_flair(volume):\n","    volume = np.nan_to_num(\n","        volume.astype(np.float32)\n","    )\n","\n","    foreground = volume > 0\n","\n","    if foreground.sum() == 0:\n","        return volume.astype(np.float32)\n","\n","    foreground_values = volume[foreground]\n","\n","    low, high = np.percentile(\n","        foreground_values,\n","        [1, 99],\n","    )\n","\n","    volume = np.clip(\n","        volume,\n","        low,\n","        high,\n","    )\n","\n","    mean = volume[foreground].mean()\n","    std = volume[foreground].std()\n","\n","    if std < 1e-6:\n","        std = 1.0\n","\n","    volume[foreground] = (\n","        volume[foreground] - mean\n","    ) / std\n","\n","    volume[~foreground] = 0.0\n","\n","    return volume.astype(np.float32)\n","\n","\n","def resize_volume_2d(volume_z_hw, mode):\n","    tensor = torch.from_numpy(\n","        volume_z_hw[:, None]\n","    ).float()\n","\n","    if mode == \"image\":\n","        resized = F.interpolate(\n","            tensor,\n","            size=(IMG_SIZE, IMG_SIZE),\n","            mode=\"bilinear\",\n","            align_corners=False,\n","        )\n","    else:\n","        resized = F.interpolate(\n","            tensor,\n","            size=(IMG_SIZE, IMG_SIZE),\n","            mode=\"nearest\",\n","        )\n","\n","    return resized.numpy()\n","\n","\n","def preprocess_patient(case_id):\n","    output_path = PROCESSED_DIR / f\"{case_id}.npz\"\n","\n","    if output_path.exists():\n","        return output_path\n","\n","    patient_dir = patient_dir_map[case_id]\n","\n","    flair_path = find_file(\n","        patient_dir,\n","        \"flair\",\n","    )\n","\n","    seg_path = find_file(\n","        patient_dir,\n","        \"seg\",\n","    )\n","\n","    flair = nib.load(\n","        str(flair_path)\n","    ).get_fdata(dtype=np.float32)\n","\n","    seg = nib.load(\n","        str(seg_path)\n","    ).get_fdata(dtype=np.float32)\n","\n","    flair = normalize_flair(\n","        flair\n","    )\n","\n","    mask = (\n","        seg > 0\n","    ).astype(np.uint8)\n","\n","    # Original BraTS shape is usually H, W, Z.\n","    # Convert it to Z, H, W for 2D slice training.\n","    flair_z_hw = np.transpose(\n","        flair,\n","        (2, 0, 1),\n","    )\n","\n","    mask_z_hw = np.transpose(\n","        mask,\n","        (2, 0, 1),\n","    )\n","\n","    images = resize_volume_2d(\n","        flair_z_hw,\n","        mode=\"image\",\n","    ).astype(np.float16)\n","\n","    masks = resize_volume_2d(\n","        mask_z_hw.astype(np.float32),\n","        mode=\"mask\",\n","    )\n","\n","    masks = (\n","        masks > 0.5\n","    ).astype(np.uint8)\n","\n","    tumor_slices = np.where(\n","        masks[:, 0].sum(axis=(1, 2)) > 0\n","    )[0].astype(np.int16)\n","\n","    np.savez(\n","        output_path,\n","        images=images,\n","        masks=masks,\n","        tumor_slices=tumor_slices,\n","        case_id=case_id,\n","    )\n","\n","    return output_path\n","\n","\n","all_ids = train_ids + val_ids + test_ids\n","\n","print(\"Preprocessing patients:\", len(all_ids))\n","print(\"Output folder:\", PROCESSED_DIR)\n","\n","for case_id in tqdm(all_ids):\n","    preprocess_patient(case_id)\n","\n","print(\"Preprocessing completed.\")\n","\n","sample_file = PROCESSED_DIR / f\"{all_ids[0]}.npz\"\n","\n","with np.load(sample_file) as data:\n","    print(\"Sample images shape:\", data[\"images\"].shape)\n","    print(\"Sample masks shape:\", data[\"masks\"].shape)\n","    print(\"Tumor slices:\", len(data[\"tumor_slices\"]))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":156,"referenced_widgets":["c8ba75c9ec00410fa05c996ed54df847","db915ce9a2a44b44876916646a6ad7a1","f0bd076a272843ab9d9feef8d90a8b29","062c2301f06948488d859777eebe5af0","996701b57198457f9e50699b2548f364","2adc21bd3d08484586780a65e726fc76","bad560b12b5b47098b0b42d12b3014c5","0591853cc3434e0ebeeae2c0362938fe","63f467685b2e497a9a243bbf07be61e7","45828f0047674255bad7906af1e28b59","5b99e4addc82409983e7a91c79f2044a"]},"id":"ojFjFQPdQYLj","executionInfo":{"status":"ok","timestamp":1783410022042,"user_tz":-330,"elapsed":95,"user":{"displayName":"","userId":""}},"outputId":"5f72e5ae-769d-439b-cbef-98f8645b618d"},"id":"ojFjFQPdQYLj","execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["Preprocessing patients: 368\n","Output folder: /content/processed_brats_flair_192\n"]},{"output_type":"display_data","data":{"text/plain":["  0%|          | 0/368 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"c8ba75c9ec00410fa05c996ed54df847"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Preprocessing completed.\n","Sample images shape: (155, 1, 192, 192)\n","Sample masks shape: (155, 1, 192, 192)\n","Tumor slices: 83\n"]}]},{"cell_type":"code","source":["# Cell 5 — Dataset and DataLoader\n","\n","class PatientCache:\n","    def __init__(\n","        self,\n","        processed_dir,\n","        max_cases=6,\n","    ):\n","        self.processed_dir = Path(processed_dir)\n","        self.max_cases = max_cases\n","        self.cache = OrderedDict()\n","\n","    def get(self, case_id):\n","        if case_id in self.cache:\n","            self.cache.move_to_end(case_id)\n","            return self.cache[case_id]\n","\n","        path = self.processed_dir / f\"{case_id}.npz\"\n","\n","        with np.load(path) as data:\n","            item = {\n","                \"images\": data[\"images\"].astype(np.float32),\n","                \"masks\": data[\"masks\"].astype(np.float32),\n","                \"tumor_slices\": data[\"tumor_slices\"].astype(np.int64),\n","            }\n","\n","        self.cache[case_id] = item\n","\n","        if len(self.cache) > self.max_cases:\n","            self.cache.popitem(last=False)\n","\n","        return item\n","\n","\n","class RandomSliceDataset(Dataset):\n","    def __init__(\n","        self,\n","        case_ids,\n","        processed_dir,\n","        samples_per_epoch,\n","        tumor_probability=0.75,\n","        augment=True,\n","    ):\n","        self.case_ids = list(case_ids)\n","        self.samples_per_epoch = samples_per_epoch\n","        self.tumor_probability = tumor_probability\n","        self.augment = augment\n","        self.cache = PatientCache(\n","            processed_dir,\n","            max_cases=6,\n","        )\n","\n","        self.metadata = {}\n","\n","        for case_id in self.case_ids:\n","            with np.load(\n","                Path(processed_dir) / f\"{case_id}.npz\"\n","            ) as data:\n","                self.metadata[case_id] = {\n","                    \"num_slices\": int(data[\"images\"].shape[0]),\n","                    \"tumor_slices\": data[\"tumor_slices\"].astype(np.int64),\n","                }\n","\n","    def __len__(self):\n","        return self.samples_per_epoch\n","\n","    def __getitem__(self, index):\n","        case_id = random.choice(\n","            self.case_ids\n","        )\n","\n","        meta = self.metadata[case_id]\n","        tumor_slices = meta[\"tumor_slices\"]\n","\n","        if (\n","            len(tumor_slices) > 0\n","            and random.random() < self.tumor_probability\n","        ):\n","            slice_index = int(\n","                np.random.choice(tumor_slices)\n","            )\n","        else:\n","            slice_index = random.randint(\n","                0,\n","                meta[\"num_slices\"] - 1,\n","            )\n","\n","        item = self.cache.get(case_id)\n","\n","        image = item[\"images\"][slice_index]\n","        mask = item[\"masks\"][slice_index]\n","\n","        if self.augment:\n","            if random.random() < 0.5:\n","                image = image[:, :, ::-1].copy()\n","                mask = mask[:, :, ::-1].copy()\n","\n","            if random.random() < 0.5:\n","                image = image[:, ::-1, :].copy()\n","                mask = mask[:, ::-1, :].copy()\n","\n","            if random.random() < 0.3:\n","                scale = random.uniform(0.90, 1.10)\n","                shift = random.uniform(-0.05, 0.05)\n","                image = image * scale + shift\n","\n","        return {\n","            \"image\": torch.from_numpy(image).float(),\n","            \"mask\": torch.from_numpy(mask).float(),\n","            \"case_id\": case_id,\n","            \"slice_index\": slice_index,\n","        }\n","\n","\n","class QuickValidationDataset(Dataset):\n","    def __init__(\n","        self,\n","        case_ids,\n","        processed_dir,\n","        max_slices_per_patient=20,\n","    ):\n","        self.items = []\n","        self.processed_dir = Path(processed_dir)\n","\n","        for case_id in case_ids:\n","            path = self.processed_dir / f\"{case_id}.npz\"\n","\n","            with np.load(path) as data:\n","                num_slices = int(data[\"images\"].shape[0])\n","                tumor_slices = data[\"tumor_slices\"].astype(np.int64)\n","\n","            selected = []\n","\n","            if len(tumor_slices) > 0:\n","                selected.extend(\n","                    tumor_slices[\n","                        np.linspace(\n","                            0,\n","                            len(tumor_slices) - 1,\n","                            min(\n","                                len(tumor_slices),\n","                                max_slices_per_patient,\n","                            ),\n","                            dtype=int,\n","                        )\n","                    ].tolist()\n","                )\n","\n","            if len(selected) < max_slices_per_patient:\n","                extra = np.linspace(\n","                    0,\n","                    num_slices - 1,\n","                    max_slices_per_patient - len(selected),\n","                    dtype=int,\n","                ).tolist()\n","\n","                selected.extend(extra)\n","\n","            selected = sorted(\n","                list(set(selected))\n","            )\n","\n","            for slice_index in selected:\n","                self.items.append(\n","                    (\n","                        case_id,\n","                        int(slice_index),\n","                    )\n","                )\n","\n","        self.cache = PatientCache(\n","            processed_dir,\n","            max_cases=6,\n","        )\n","\n","    def __len__(self):\n","        return len(self.items)\n","\n","    def __getitem__(self, index):\n","        case_id, slice_index = self.items[index]\n","\n","        item = self.cache.get(case_id)\n","\n","        image = item[\"images\"][slice_index]\n","        mask = item[\"masks\"][slice_index]\n","\n","        return {\n","            \"image\": torch.from_numpy(image).float(),\n","            \"mask\": torch.from_numpy(mask).float(),\n","            \"case_id\": case_id,\n","            \"slice_index\": slice_index,\n","        }\n","\n","\n","quick_val_ids = val_ids[: min(12, len(val_ids))]\n","\n","train_dataset = RandomSliceDataset(\n","    train_ids,\n","    PROCESSED_DIR,\n","    samples_per_epoch=TRAIN_SAMPLES_PER_EPOCH,\n","    tumor_probability=TUMOR_SLICE_PROBABILITY,\n","    augment=True,\n",")\n","\n","quick_validation_dataset = QuickValidationDataset(\n","    quick_val_ids,\n","    PROCESSED_DIR,\n","    max_slices_per_patient=20,\n",")\n","\n","train_loader = DataLoader(\n","    train_dataset,\n","    batch_size=BATCH_SIZE,\n","    shuffle=True,\n","    num_workers=NUM_WORKERS,\n","    pin_memory=True,\n",")\n","\n","quick_validation_loader = DataLoader(\n","    quick_validation_dataset,\n","    batch_size=BATCH_SIZE,\n","    shuffle=False,\n","    num_workers=NUM_WORKERS,\n","    pin_memory=True,\n",")\n","\n","print(\"Train batches:\", len(train_loader))\n","print(\"Quick validation slices:\", len(quick_validation_dataset))\n","\n","batch = next(iter(train_loader))\n","print(\"Image batch:\", batch[\"image\"].shape)\n","print(\"Mask batch:\", batch[\"mask\"].shape)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"DlGTlXCPQYJN","executionInfo":{"status":"ok","timestamp":1783410027846,"user_tz":-330,"elapsed":5797,"user":{"displayName":"","userId":""}},"outputId":"b2e98860-1cf6-4425-d3bc-6daa8e01098c"},"id":"DlGTlXCPQYJN","execution_count":19,"outputs":[{"output_type":"stream","name":"stdout","text":["Train batches: 375\n","Quick validation slices: 240\n","Image batch: torch.Size([8, 1, 192, 192])\n","Mask batch: torch.Size([8, 1, 192, 192])\n"]}]},{"cell_type":"code","source":["# Cell 6 — Model architecture\n","\n","class DoubleConv(nn.Module):\n","    def __init__(\n","        self,\n","        in_channels,\n","        out_channels,\n","    ):\n","        super().__init__()\n","\n","        self.block = nn.Sequential(\n","            nn.Conv2d(\n","                in_channels,\n","                out_channels,\n","                kernel_size=3,\n","                padding=1,\n","                bias=False,\n","            ),\n","            nn.BatchNorm2d(out_channels),\n","            nn.ReLU(inplace=True),\n","\n","            nn.Conv2d(\n","                out_channels,\n","                out_channels,\n","                kernel_size=3,\n","                padding=1,\n","                bias=False,\n","            ),\n","            nn.BatchNorm2d(out_channels),\n","            nn.ReLU(inplace=True),\n","        )\n","\n","    def forward(self, x):\n","        return self.block(x)\n","\n","\n","class BottleneckSelfAttention(nn.Module):\n","    def __init__(\n","        self,\n","        channels,\n","        num_heads=4,\n","    ):\n","        super().__init__()\n","\n","        self.norm = nn.LayerNorm(channels)\n","\n","        self.attention = nn.MultiheadAttention(\n","            embed_dim=channels,\n","            num_heads=num_heads,\n","            batch_first=True,\n","        )\n","\n","    def forward(self, x):\n","        batch_size, channels, height, width = x.shape\n","\n","        tokens = x.flatten(2).transpose(1, 2)\n","\n","        normalized = self.norm(tokens)\n","\n","        attended, _ = self.attention(\n","            normalized,\n","            normalized,\n","            normalized,\n","            need_weights=False,\n","        )\n","\n","        tokens = tokens + attended\n","\n","        output = tokens.transpose(1, 2).reshape(\n","            batch_size,\n","            channels,\n","            height,\n","            width,\n","        )\n","\n","        return output\n","\n","\n","class AttentionGate(nn.Module):\n","    def __init__(\n","        self,\n","        gate_channels,\n","        skip_channels,\n","        intermediate_channels,\n","    ):\n","        super().__init__()\n","\n","        self.gate_projection = nn.Sequential(\n","            nn.Conv2d(\n","                gate_channels,\n","                intermediate_channels,\n","                kernel_size=1,\n","                bias=True,\n","            ),\n","            nn.BatchNorm2d(intermediate_channels),\n","        )\n","\n","        self.skip_projection = nn.Sequential(\n","            nn.Conv2d(\n","                skip_channels,\n","                intermediate_channels,\n","                kernel_size=1,\n","                bias=True,\n","            ),\n","            nn.BatchNorm2d(intermediate_channels),\n","        )\n","\n","        self.psi = nn.Sequential(\n","            nn.Conv2d(\n","                intermediate_channels,\n","                1,\n","                kernel_size=1,\n","                bias=True,\n","            ),\n","            nn.BatchNorm2d(1),\n","            nn.Sigmoid(),\n","        )\n","\n","        self.relu = nn.ReLU(inplace=True)\n","\n","    def forward(\n","        self,\n","        gate,\n","        skip,\n","    ):\n","        gate_features = self.gate_projection(gate)\n","        skip_features = self.skip_projection(skip)\n","\n","        attention = self.relu(\n","            gate_features + skip_features\n","        )\n","\n","        attention = self.psi(attention)\n","\n","        return skip * attention\n","\n","\n","class AttentionUNet2D(nn.Module):\n","    def __init__(\n","        self,\n","        in_channels=1,\n","        out_channels=1,\n","        base=16,\n","        attention_mode=\"cross\",\n","    ):\n","        super().__init__()\n","\n","        self.attention_mode = attention_mode\n","\n","        self.enc1 = DoubleConv(\n","            in_channels,\n","            base,\n","        )\n","\n","        self.pool1 = nn.MaxPool2d(2)\n","\n","        self.enc2 = DoubleConv(\n","            base,\n","            base * 2,\n","        )\n","\n","        self.pool2 = nn.MaxPool2d(2)\n","\n","        self.enc3 = DoubleConv(\n","            base * 2,\n","            base * 4,\n","        )\n","\n","        self.pool3 = nn.MaxPool2d(2)\n","\n","        self.enc4 = DoubleConv(\n","            base * 4,\n","            base * 8,\n","        )\n","\n","        self.pool4 = nn.MaxPool2d(2)\n","\n","        self.bottleneck = DoubleConv(\n","            base * 8,\n","            base * 16,\n","        )\n","\n","        if attention_mode == \"self\":\n","            self.self_attention = BottleneckSelfAttention(\n","                base * 16,\n","                num_heads=4,\n","            )\n","        else:\n","            self.self_attention = nn.Identity()\n","\n","        self.up4 = nn.ConvTranspose2d(\n","            base * 16,\n","            base * 8,\n","            kernel_size=2,\n","            stride=2,\n","        )\n","\n","        self.up3 = nn.ConvTranspose2d(\n","            base * 8,\n","            base * 4,\n","            kernel_size=2,\n","            stride=2,\n","        )\n","\n","        self.up2 = nn.ConvTranspose2d(\n","            base * 4,\n","            base * 2,\n","            kernel_size=2,\n","            stride=2,\n","        )\n","\n","        self.up1 = nn.ConvTranspose2d(\n","            base * 2,\n","            base,\n","            kernel_size=2,\n","            stride=2,\n","        )\n","\n","        if attention_mode == \"cross\":\n","            self.gate4 = AttentionGate(\n","                base * 8,\n","                base * 8,\n","                base * 4,\n","            )\n","\n","            self.gate3 = AttentionGate(\n","                base * 4,\n","                base * 4,\n","                base * 2,\n","            )\n","\n","            self.gate2 = AttentionGate(\n","                base * 2,\n","                base * 2,\n","                base,\n","            )\n","\n","            self.gate1 = AttentionGate(\n","                base,\n","                base,\n","                base // 2,\n","            )\n"," 