ECAY = 1e-4\n","\n","TUMOR_SLICE_PROBABILITY = 0.75\n","NUM_WORKERS = 0\n","\n","USE_PRETRAINED_PLAIN_UNET = True\n","USE_TTA_FOR_FINAL_EVAL = True\n","\n","# If your dataset ZIP has a known path, write it here.\n","# Otherwise keep None and the code will search Google Drive.\n","MANUAL_BRATS_ZIP = None\n","\n","# Example:\n","# MANUAL_BRATS_ZIP = Path(\"/content/drive/MyDrive/BraTS2020/BraTS2020_TrainingData.zip\")\n","\n","# If dataset is already extracted, put the root folder here.\n","# This should contain BraTS20_Training_001, BraTS20_Training_002, etc.\n","MANUAL_BRATS_ROOT = None\n","\n","# Example:\n","# MANUAL_BRATS_ROOT = Path(\"/content/brats2020/MICCAI_BraTS2020_TrainingData\")\n","\n","\n","CONTENT_DIR = Path(\"/content\")\n","EXTRACT_DIR = CONTENT_DIR / \"brats2020\"\n","PROCESSED_DIR = CONTENT_DIR / \"processed_brats_flair_192\"\n","\n","RESULTS_DIR = CONTENT_DIR / \"brats_attention_colab_results\"\n","CHECKPOINT_DIR = RESULTS_DIR / \"checkpoints\"\n","\n","DRIVE_SAVE_DIR = Path(\"/content/drive/MyDrive/brats_attention_outputs\")\n","DRIVE_SAVE_DIR.mkdir(parents=True, exist_ok=True)\n","\n","RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n","CHECKPOINT_DIR.mkdir(parents=True, exist_ok=True)\n","PROCESSED_DIR.mkdir(parents=True, exist_ok=True)\n","\n","CONFIG = {\n","    \"attention_mode\": ATTENTION_MODE,\n","    \"image_size\": IMG_SIZE,\n","    \"batch_size\": BATCH_SIZE,\n","    \"num_epochs\": NUM_EPOCHS,\n","    \"train_samples_per_epoch\": TRAIN_SAMPLES_PER_EPOCH,\n","    \"learning_rate\": LEARNING_RATE,\n","    \"weight_decay\": WEIGHT_DECAY,\n","    \"tumor_slice_probability\": TUMOR_SLICE_PROBABILITY,\n","    \"input_modality\": \"FLAIR only\",\n","    \"task\": \"Binary whole-tumour segmentation\",\n","    \"device\": str(DEVICE),\n","}\n","\n","with open(RESULTS_DIR / \"config.json\", \"w\") as f:\n","    json.dump(CONFIG, f, indent=2)\n","\n","with open(DRIVE_SAVE_DIR / \"config.json\", \"w\") as f:\n","    json.dump(CONFIG, f, indent=2)\n","\n","print(\"Drive output folder:\", DRIVE_SAVE_DIR)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Z6acvB16QYTG","executionInfo":{"status":"ok","timestamp":1783410021805,"user_tz":-330,"elapsed":6179,"user":{"displayName":"","userId":""}},"outputId":"028139bb-fd25-4950-a8f3-b2caef3eba77"},"id":"Z6acvB16QYTG","execution_count":15,"outputs":[{"output_type":"stream","name":"stdout","text":["Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n","Device: cuda\n","GPU: Tesla T4\n","Drive output folder: /content/drive/MyDrive/brats_attention_outputs\n"]}]},{"cell_type":"code","source":["# Cell 2 — Locate and extract BraTS 2020 dataset\n","\n","def patient_is_valid(patient_dir):\n","    patient_dir = Path(patient_dir)\n","\n","    flair_files = (\n","        list(patient_dir.glob(\"*_flair.nii\"))\n","        + list(patient_dir.glob(\"*_flair.nii.gz\"))\n","    )\n","\n","    seg_files = (\n","        list(patient_dir.glob(\"*_seg.nii\"))\n","        + list(patient_dir.glob(\"*_seg.nii.gz\"))\n","    )\n","\n","    return (\n","        patient_dir.is_dir()\n","        and patient_dir.name.startswith(\"BraTS20_Training_\")\n","        and len(flair_files) > 0\n","        and len(seg_files) > 0\n","    )\n","\n","\n","def count_valid_patients(root):\n","    root = Path(root)\n","\n","    if not root.exists():\n","        return 0\n","\n","    return len(\n","        [\n","            p for p in root.glob(\"BraTS20_Training_*\")\n","            if patient_is_valid(p)\n","        ]\n","    )\n","\n","\n","def find_brats_root(search_roots):\n","    for search_root in search_roots:\n","        search_root = Path(search_root)\n","\n","        if not search_root.exists():\n","            continue\n","\n","        if count_valid_patients(search_root) > 0:\n","            return search_root\n","\n","        for current_root, dirs, files in os.walk(search_root):\n","            current_path = Path(current_root)\n","\n","            if count_valid_patients(current_path) > 0:\n","                return current_path\n","\n","    return None\n","\n","\n","def find_brats_zip():\n","    if MANUAL_BRATS_ZIP is not None:\n","        manual_zip = Path(MANUAL_BRATS_ZIP)\n","\n","        if manual_zip.exists():\n","            return manual_zip\n","\n","        raise FileNotFoundError(\n","            f\"Manual ZIP path does not exist: {manual_zip}\"\n","        )\n","\n","    search_root = Path(\"/content/drive/MyDrive\")\n","\n","    zip_candidates = []\n","\n","    for pattern in [\n","        \"*brats*.zip\",\n","        \"*BraTS*.zip\",\n","        \"*MICCAI*.zip\",\n","    ]:\n","        zip_candidates.extend(\n","            list(search_root.rglob(pattern))\n","        )\n","\n","    zip_candidates = sorted(\n","        zip_candidates,\n","        key=lambda p: p.stat().st_size,\n","        reverse=True,\n","    )\n","\n","    if len(zip_candidates) == 0:\n","        return None\n","\n","    return zip_candidates[0]\n","\n","\n","# 1. Check already extracted/manual root.\n","BRATS_ROOT = None\n","\n","if MANUAL_BRATS_ROOT is not None:\n","    manual_root = Path(MANUAL_BRATS_ROOT)\n","\n","    if count_valid_patients(manual_root) > 0:\n","        BRATS_ROOT = manual_root\n","    else:\n","        raise FileNotFoundError(\n","            f\"MANUAL_BRATS_ROOT was given but no BraTS patients found: {manual_root}\"\n","        )\n","\n","\n","# 2. Check /content if already extracted.\n","if BRATS_ROOT is None:\n","    BRATS_ROOT = find_brats_root(\n","        [\n","            EXTRACT_DIR,\n","            CONTENT_DIR,\n","        ]\n","    )\n","\n","\n","# 3. If not extracted, search ZIP in Drive and unzip.\n","if BRATS_ROOT is None:\n","    brats_zip = find_brats_zip()\n","\n","    if brats_zip is None:\n","        raise FileNotFoundError(\n","            \"BraTS ZIP not found in Google Drive.\\n\"\n","            \"Upload the BraTS 2020 dataset ZIP