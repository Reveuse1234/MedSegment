    use_tta=True,\n","):\n","    model.eval()\n","\n","    path = PROCESSED_DIR / f\"{case_id}.npz\"\n","\n","    with np.load(path) as data:\n","        images = data[\"images\"].astype(np.float32)\n","        masks = data[\"masks\"].astype(np.uint8)\n","\n","    probability_slices = []\n","\n","    for start in range(\n","        0,\n","        images.shape[0],\n","        BATCH_SIZE,\n","    ):\n","        batch_images = torch.from_numpy(\n","            images[start:start + BATCH_SIZE]\n","        ).to(DEVICE).float()\n","\n","        logits = model(batch_images)\n","\n","        probabilities = torch.sigmoid(\n","            logits\n","        )\n","\n","        if use_tta:\n","            flipped_images = torch.flip(\n","                batch_images,\n","                dims=[3],\n","            )\n","\n","            flipped_logits = model(\n","                flipped_images\n","            )\n","\n","            flipped_probabilities = torch.sigmoid(\n","                flipped_logits\n","            )\n","\n","            flipped_probabilities = torch.flip(\n","                flipped_probabilities,\n","                dims=[3],\n","            )\n","\n","            probabilities = 0.5 * (\n","                probabilities\n","                + flipped_probabilities\n","            )\n","\n","        probability_slices.append(\n","            probabilities.detach()\n","            .cpu()\n","            .numpy()[:, 0]\n","        )\n","\n","    probability_volume = np.concatenate(\n","        probability_slices,\n","        axis=0,\n","    ).astype(np.float16)\n","\n","    target_volume = (\n","        masks[:, 0] > 0\n","    )\n","\n","    return probability_volume, target_volume\n","\n","\n","def evaluate_probability_dict(\n","    probability_dict,\n","    target_dict,\n","    ids,\n","    threshold,\n","    min_component_size,\n","):\n","    patient_counts = {}\n","    rows = []\n","\n","    for case_id in ids:\n","        probabilities = probability_dict[case_id]\n","        targets = target_dict[case_id]\n","\n","        predictions = probabilities >= threshold\n","\n","        predictions = remove_small_components_3d(\n","            predictions,\n","            min_component_size,\n","        )\n","\n","        counts = confusion_counts(\n","            predictions,\n","            targets,\n","        )\n","\n","        patient_counts[case_id] = counts\n","\n","        metrics = metrics_from_counts(\n","            *counts.tolist()\n","        )\n","\n","        metrics[\"case_id\"] = case_id\n","        metrics[\"gt_voxels\"] = int(\n","            targets.sum()\n","        )\n","\n","        metrics[\"predicted_voxels\"] = int(\n","            predictions.sum()\n","        )\n","\n","        rows.append(metrics)\n","\n","    summary = mean_patient_metrics(\n","        patient_counts\n","    )\n","\n","    return summary, pd.DataFrame(rows)\n","\n","\n","best_checkpoint_path = (\n","    DRIVE_SAVE_DIR\n","    / f\"best_{ATTENTION_MODE}_attention_unet.pt\"\n",")\n","\n","if not best_checkpoint_path.exists():\n","    raise FileNotFoundError(\n","        f\"Best checkpoint not found: {best_checkpoint_path}\"\n","    )\n","\n","print(\"Loading best checkpoint:\")\n","print(best_checkpoint_path)\n","\n","model = create_model(\n","    ATTENTION_MODE\n",")\n","\n","checkpoint = safe_torch_load(\n","    best_checkpoint_path\n",")\n","\n","model.load_state_dict(\n","    checkpoint[\"model_state_dict\"],\n","    strict=True,\n",")\n","\n","model.eval()\n","\n","\n","# -------------------------------\n","# Full validation prediction\n","# -------------------------------\n","\n","print(\"\\nPredicting validation patients...\")\n","\n","val_probability_dict = {}\n","val_target_dict = {}\n","\n","for case_id in tqdm(val_ids):\n","    probabilities, targets = predict_patient_probability(\n","        model,\n","        case_id,\n","        use_tta=USE_TTA_FOR_FINAL_EVAL,\n","    )\n","\n","    val_probability_dict[case_id] = probabilities\n","    val_target_dict[case_id] = targets\n","\n","\n","# -------------------------------\n","# Threshold and post-processing search\n","# -------------------------------\n","\n","thresholds = [\n","    0.35,\n","    0.40,\n","    0.45,\n","    0.50,\n","    0.55,\n","    0.60,\n","    0.65,\n","    0.70,\n","    0.75,\n","]\n","\n","component_sizes = [\n","    0,\n","    100,\n","    300,\n","    500,\n","    1000,\n","]\n","\n","search_rows = []\n","\n","best_validation = None\n","\n","for threshold in thresholds:\n","    for min_component_size in component_sizes:\n","        summary, _ = evaluate_probability_dict(\n","            val_probability_dict,\n","            val_target_dict,\n","            val_ids,\n","            threshold=threshold,\n","            min_component_size=min_component_size,\n","        )\n","\n","        row = {\n","            \"threshold\": threshold,\n","            \"min_component_size\": min_component_size,\n","            **summary,\n","        }\n","\n","        search_rows.append(row)\n","\n","        if (\n","            best_validation is None\n","            or row[\"dice\"] > best_validation[\"dice\"]\n","        ):\n","            best_validation = row\n","\n","\n","validation_search_df = pd.DataFrame(\n","    search_rows\n",").sort_values(\n","    \"dice\",\n","    ascending=False,\n",")\n","\n","validation_search_path = (\n","    DRIVE_SAVE_DIR\n","    / f\"validation_threshold_search_{ATTENTION_MODE}.csv\"\n",")\n","\n","validation_search_df.to_csv(\n","    validation_search_path,\n","    index=False,\n",")\n","\n","print(\"\\nBest validation setting:\")\n","print(best_validation)\n","\n","display(\n","    validation_search_df.head(10)\n",")\n","\n","\n","# -------------------------------\n","# Final test evaluation\n","# -------------------------------\n","\n","best_threshold = float(\n","    best_validation[\"threshold\"]\n",")\n","\n","best_component_size = int(\n","    best_validation[\"min_component_size\"]\n",")\n","\n","print(\"\\nPredicting test patients...\")\n","\n","test_probability_dict = {}\n","test_target_dict = {}\n","\n","for case_id in tqdm(test_ids):\n","    probabilities, targets = predict_patient_probability(\n","        model,\n","        case_id,\n","        use_tta=USE_TTA_FOR_FINAL_EVAL,\n","    )\n","\n","    test_probability_dict[case_id] = probabilities\n","    test_target_dict[case_id] = targets\n","\n","\n","test_summary, test_patient_df = evaluate_probability_dict(\n","    test_probability_dict,\n","    test_target_dict,\n","    test_ids,\n","    threshold=best_threshold,\n","    min_component_size=best_component_size,\n",")\n","\n","test_summary[\"threshold\"] = best_threshold\n","test_summary[\"min_component_size\"] = best_component_size\n","test_summary[\"attention_mode\"] = ATTENTION_MODE\n","test_summary[\"input_modality\"] = \"FLAIR only\"\n","\n","test_summary_path = (\n","    DRIVE_SAVE_DIR\n","    / f\"test_summary_{ATTENTION_MODE}.json\"\n",")\n","\n","test_patient_metrics_path = (\n","    DRIVE_SAVE_DIR\n","    / f\"test_patient_metrics_{ATTENTION_MODE}.csv\"\n",")\n","\n","with open(test_summary_path, \"w\") as f:\n","    json.dump(\n","        test_summary,\n","        f,\n","        indent=2,\n","    )\n","\n","test_patient_df.to_csv(\n","    test_patient_metrics_path,\n","    index=False,\n",")\n","\n","print(\"\\nFINAL TEST SUMMARY\")\n","print(json.dumps(test_summary, indent=2))\n","\n","print(\"\\nTest patient metrics saved to:\")\n","print(test_patient_metrics_path)\n","\n","display(\n","    test_patient_df.sort_values(\n","        \"dice\",\n","        ascending=False,\n","    ).head(10)\n",")\n","\n","del model\n","torch.cuda.empty_cache()\n","gc.collect()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"referenced_widgets":["8ba7714608cf4692bc458ed17b9ddc15","67a81e47f95b438fb77e858b0b5f0263","0797838597bb48b4802ccfc36a8c5ebb","363c8ede38c244ee991df801a89911e1","118c46b390d94c069d869209d123