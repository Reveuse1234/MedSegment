path,\n","        )\n","\n","        marker = \" * best\" if improved else \"\"\n","\n","        print(\n","            f\"{attention_mode} | \"\n","            f\"Epoch {epoch:02d}/{NUM_EPOCHS} | \"\n","            f\"loss {train_loss:.4f} | \"\n","            f\"quick val Dice {validation_metrics['dice']:.4f} | \"\n","            f\"sensitivity {validation_metrics['sensitivity']:.4f} | \"\n","            f\"precision {validation_metrics['precision']:.4f} | \"\n","            f\"skipped {skipped_batches}\"\n","            f\"{marker}\"\n","        )\n","\n","        if patience_counter >= EARLY_STOPPING_PATIENCE:\n","            print(\n","                \"Early stopping at epoch:\",\n","                epoch,\n","            )\n","            break\n","\n","    summary = {\n","        \"attention_mode\": attention_mode,\n","        \"best_quick_validation_dice\": float(best_val_dice),\n","        \"best_checkpoint_drive\": str(drive_best_checkpoint_path),\n","        \"latest_checkpoint_drive\": str(drive_latest_checkpoint_path),\n","        \"history_drive\": str(drive_history_path),\n","    }\n","\n","    with open(\n","        DRIVE_SAVE_DIR / f\"training_summary_{attention_mode}.json\",\n","        \"w\",\n","    ) as f:\n","        json.dump(summary, f, indent=2)\n","\n","    del model\n","    torch.cuda.empty_cache()\n","    gc.collect()\n","\n","    return summary\n","\n","\n","training_summary = train_attention_model(\n","    ATTENTION_MODE\n",")\n","\n","training_summary"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":448,"referenced_widgets":["979539e296234665bd52c48e29fe6564","5664ecc49ddd4ca8bb45f9e91184945a","6e48ef217ab3411a94b7810b0d71e4e6","2e27a59a995447cbbc4cc26dc7f1cc13","ef1accba721f4f18a82d442a9dc39663","c786b7700b334dbf9c446673401c6c54","40528fea935e436fa6cb6ed61c05104a","1c62c69fee8e486793b15c78b455d4ab","ab89652f4b244af882c06c8e324a810a","6d0b3e26106b4a15babfa27b47042983","99d67f54233d4b0caa2c17e4c118c1c1","48a50c85423