n","previous_checkpoint_path = find_previous_checkpoint()\n","\n","\n","def load_partial_plain_unet_weights(\n","    model,\n","    checkpoint_path,\n","):\n","    if checkpoint_path is None:\n","        print(\n","            \"No previous checkpoint available. Training from scratch.\"\n","        )\n","        return 0\n","\n","    checkpoint = safe_torch_load(\n","        checkpoint_path\n","    )\n","\n","    source_state = strip_module_prefix(\n","        extract_state_dict(checkpoint)\n","    )\n","\n","    target_state = model.state_dict()\n","\n","    compatible = {}\n","\n","    # Direct same-name loading\n","    for key, value in source_state.items():\n","        if (\n","            key in target_state\n","            and isinstance(value, torch.Tensor)\n","            and target_state[key].shape == value.shape\n","        ):\n","            compatible[key] = value\n","\n","    # Common old plain U-Net prefix mapping\n","    key_map = {\n","        \"input_block.\": \"enc1.\",\n","        \"down1.block.1.\": \"enc2.\",\n","        \"down2.block.1.\": \"enc3.\",\n","        \"down3.block.1.\": \"enc4.\",\n","        \"down4.block.1.\": \"bottleneck.\",\n","        \"up1.up.\": \"up4.\",\n","        \"up1.conv.\": \"dec4.\",\n","        \"up2.up.\": \"up3.\",\n","        \"up2.conv.\": \"dec3.\",\n","        \"up3.up.\": \"up2.\",\n","        \"up3.conv.\": \"dec2.\",\n","        \"up4.up.\": \"up1.\",\n","        \"up4.conv.\": \"dec1.\",\n","        \"output.\": \"out_conv.\",\n","    }\n","\n","    for old_key, value in source_state.items():\n","        if not isinstance(value, torch.Tensor):\n","            continue\n","\n","        for old_prefix, new_prefix in key_map.items():\n","            if old_key.startswith(old_prefix):\n","                new_key = (\n","                    new_prefix\n","                    + old_key[len(old_prefix):]\n","                )\n","\n","                if (\n","                    new_key in target_state\n","                    and target_state[new_key].shape == value.shape\n","                ):\n","                    compatible[new_key] = value\n","\n","                break\n","\n","    target_state.update(compatible)\n","\n","    model.load_state_dict(\n","        target_state,\n","        strict=False,\n","    )\n","\n","    print(\n","        \"Loaded compatible tensors from previous U-Net:\",\n","        len(compatible),\n","    )\n","\n","    return len(compatible)\n","\n","\n","@torch.no_grad()\n","def validate_slices(\n","    model,\n","    loader,\n","    threshold=0.50,\n","):\n","    model.eval()\n","\n","    patient_counts = defaultdict(\n","        lambda: np.zeros(\n","            4,\n","            dtype=np.int64,\n","        )\n","    )\n","\n","    for batch in tqdm(\n","        loader,\n","        desc=\"Quick validation\",\n","        leave=False,\n","    ):\n","        images = batch[\"image\"].to(\n","            DEVICE\n","        ).float()\n","\n","        masks = batch[\"mask\"].to(\n","            DEVICE\n","        ).float()\n","\n","        logits = model(images)\n","\n","        probabilities = torch.sigmoid(\n","            logits\n","        )\n","\n","        predictions = probabilities >= threshold\n","        targets = masks >= 0.50\n","\n","        for index, case_id in enumerate(\n","            batch[\"case_id\"]\n","        ):\n","            patient_counts[case_id] += confusion_counts(\n","                predictions[index:index + 1],\n","                targets[index:index + 1],\n","            )\n","\n","    return mean_patient_metrics(\n","        patient_counts\n","    )\n","\n","\n","criterion = DiceBCELoss()\n","\n","diagnostic_model = create_model(\n","    ATTENTION_MODE\n",")\n","\n","if USE_PRETRAINED_PLAIN_UNET:\n","    load_partial_plain_unet_weights(\n","        diagnostic_model,\n","        previous_checkpoint_path,\n","    )\n","\n","diagnostic_batch = next(\n","    iter(train_loader)\n",")\n","\n","with torch.no_grad():