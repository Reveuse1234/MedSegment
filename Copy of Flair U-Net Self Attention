\"].shape[0]),\n","                    \"tumor_slices\": data[\"tumor_slices\"].astype(np.int64),\n","                }\n","\n","    def __len__(self):\n","        return self.samples_per_epoch\n","\n","    def __getitem__(self, index):\n","        case_id = random.choice(\n","            self.case_ids\n","        )\n","\n","        meta = self.metadata[case_id]\n","        tumor_slices = meta[\"tumor_slices\"]\n","\n","        if (\n","            len(tumor_slices) > 0\n","            and random.random() < self.tumor_probability\n","        ):\n","            slice_index = int(\n","                np.random.choice(tumor_slices)\n","            )\n","        else:\n","            slice_index = random.randint(\n","                0,\n","                meta[\"num_slices\"] - 1,\n","            )\n","\n","        item = self.cache.get(case_id)\n","\n","        image = item[\"images\"][slice_index]\n","        mask = item[\"masks\"][slice_index]\n","\n","        if self.augment:\n","            if random.random() < 0.5:\n","                image = image[:, :, ::-1].copy()\n","                mask = mask[:, :, ::-1].copy()\n","\n","            if random.random() < 0.5:\n","                image = image[:, ::-1, :].copy()\n","                mask = mask[:, ::-1, :].copy()\n","\n","            if random.random() < 0.3:\n","                scale = random.uniform(0.90, 1.10)\n","                shift = random.uniform(-0.05, 0.05)\n","                image = image * scale + shift\n","\n","        return {\n","            \"image\": torch.from_numpy(image).float(),\n","            \"mask\": torch.from_numpy(mask).float(),\n","            \"case_id\": case_id,\n","            \"slice_index\": slice_index,\n","        }\n","\n","\n","class QuickValidationDataset(Dataset):\n","    def __init__(\n","        self,\n","        case_ids,\n","        processed_dir,\n","        max_slices_per_patient=20,\n","    ):\n","        self.items = []\n","        self.processed_dir = Path(processed_dir)\n","\n","        for case_id in case_ids:\n","            path = self.processed_dir / f\"{case_id}.npz\"\n","\n","            with np.load(path) as data:\n","                num_slices = int(data[\"images\"].shape[0])\n","                tumor_slices = data[\"tumor_slices\"].astype(np.int64)\n","\n","            selected = []\n","\n","            if len(tumor_slices) > 0:\n","                selected.extend(\n","                    tumor_slices[\n","                        np.linspace(\n","                            0,\n","                            len(tumor_slices) - 1,\n","                            min(\n","                                len(tumor_slices),\n","                                max_slices_per_patient,\n","                            ),\n","                            dtype=int,\n","                        )\n","                    ].tolist()\n","                )\n","\n","            if len(selected) < max_slices_per_patient:\n","                extra = np.linspace(\n","                    0,\n","                    num_slices - 1,\n","                    max_slices_per_patient - len(selected),\n","                    dtype=int,\n","                ).tolist()\n","\n","                selected.extend(extra)\n","\n","            selected = sorted(\n","                list(set(selected))\n","            )\n","\n","            for slice_index in selected:\n","                self.items.append(\n","                    (\n","                        case_id,\n","                        int(slice_index),\n","                    )\n","                )\n","\n","        self.cache = PatientCache(\n","            processed_dir,\n","            max_cases=6,\n","        )\n","\n","    def __len__(self):\n","        return len(self.items)\n","\n","    def __getitem__(self, index):\n","        case_id, slice_index = self.items[index]\n","\n","        item = self.cache.get(case_id)\n","\n","        image = item[\"images\"][slice_index]\n","        mask = item[\"masks\"][slice_index]\n","\n","        return {\n","            \"image\": torch.from_numpy(image).float(),\n","            \"mask\": torch.from_numpy(mask).float(),\n","            \"case_id\": case_id,\n","            \"slice_index\": slice_index,\n","        }\n","\n","\n","quick_val_ids = val_ids[: min(12, len(val_ids))]\n","\n","train_dataset = RandomSliceDataset(\n","    train_ids,\n","    PROCESSED_DIR,\n","    samples_per_epoch=TRAIN_SAMPLES_PER_EPOCH,\n","    tumor_probability=TUMOR_SLICE_PROBABILITY,\n","    augment=True,\n",")\n","\n","quick_validation_dataset = QuickValidationDataset(\n","    quick_val_ids,\n","    PROCESSED_DIR,\n","    max_slices_per_patient=20,\n",")\n","\n","train_loader = DataLoader(\n","    train_dataset,\n","    batch_size=BATCH_SIZE,\n","    shuffle=True,\n","    num_workers=NUM_WORKERS,\n","    pin_memory=True,\n",")\n","\n","quick_validation_loader = DataLoader(\n","    quick_validation_dataset,\n","    batch_size=BATCH_SIZE,\n","    shuffle=False,\n","    num_workers=NUM_WORKERS,\n","    pin_memory=True,\n",")\n","\n","print(\"Train batches:\", len(train_loader))\n","print(\"Quick validation slices:\", len(quick_validation_dataset))\n","\n","batch = next(iter(train_loader))\n","print(\"Image batch:\", batch[\"image\"].shape)\n","print(\"Mask batch:\", batch[\"mask\"].shape)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"DlGTlXCPQYJN","executionInfo":{"status":"ok","timestamp":1783407016356,"user_tz":-330,"elapsed":13588,"user":{"displayName":"","userId":""}},"outputId":"257bec97-9b16-4282-d069-2f5ab4da4a02"},"id":"DlGTlXCPQYJN","execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["Train batches: 375\n","Quick validation slices: 240\n","Image batch: torch.Size([8, 1, 192, 192])\n","Mask batch: torch.Size([8, 1, 192, 192])\n"]}]},{"cell_type":"code","source":["# Cell 6 — Model architecture\n","\n","class DoubleConv(nn.Module):\n","    def __init__(\n","        self,\n","        in_channels,\n","        out_channels,\n","    ):\n","        super().__init__()\n","\n","        self.block = nn.Sequential(\n","            nn.Conv2d(\n","                in_channels,\n","                out_channels,\n","                kernel_size=3,\n","                padding=1,\n","                bias=False,\n","            ),\n","            nn.BatchNorm2d(out_channels),\n","            nn.ReLU(inplace=True),\n","\n","            nn.Conv2d(\n","                out_channels,\n","                out_channels,\n","                kernel_size=3,\n","                padding=1,\n","                bias=False,\n","            ),\n","            nn.BatchNorm2d(out_channels),\n","            nn.ReLU(inplace=True),\n","        )\n","\n","    def forward(self, x):\n","        return self.block(x)\n","\n","\n","class BottleneckSelfAttention(nn.Module):\n","    def __init__(\n","        self,\n","        channels,\n","        num_heads=4,\n","    ):\n","        super().__init__()\n","\n","        self.norm = nn.LayerNorm(channels)\n","\n","        self.attention = nn.MultiheadAttention(\n","            embed_dim=channels,\n","            num_heads=num_heads,\n","            batch_first=True,\n","        )\n","\n","    def forward(self, x):\n","        batch_size, channels, height, width = x.shape\n","\n","        tokens = x.flatten(2).transpose(1, 2)\n","\n","        normalized = self.norm(tokens)\n","\n","        attended, _ = self.attention(\n","            normalized,\n","            normalized,\n","            normalized,\n","            need_weights=False,\n","        )\n","\n","        tokens = tokens + attended\n","\n","        output = tokens.transpose(1, 2).reshape(\n","            batch_size,\n","            channels,\n","            height,\n","            width,\n","        )\n","\n","        return output\n","\n","\n","class AttentionGate(nn.Module):\n","    def __init__(\n","        self,\n","        gate_channels,\n","        skip_channels,\n","  