","        self.pool2 = nn.MaxPool2d(2)\n","\n","        self.enc3 = DoubleConv(\n","            base * 2,\n","            base * 4,\n","        )\n","\n","        self.pool3 = nn.MaxPool2d(2)\n","\n","        self.enc4 = DoubleConv(\n","            base * 4,\n","            base * 8,\n","        )\n","\n","        self.pool4 = nn.MaxPool2d(2)\n","\n","        self.bottleneck = DoubleConv(\n","            base * 8,\n","            base * 16,\n","        )\n","\n","        if attention_mode == \"self\":\n","            self.self_attention = BottleneckSelfAttention(\n","                base * 16,\n","                num_heads=4,\n","            )\n","        else:\n","            self.self_attention = nn.Identity()\n","\n","        self.up4 = nn.ConvTranspose2d(\n","            base * 16,\n","            base * 8,\n","            kernel_size=2,\n","            stride=2,\n","        )\n","\n","        self.up3 = nn.ConvTranspose2d(\n","            base * 8,\n","            base * 4,\n","            kernel_size=2,\n","            stride=2,\n","        )\n","\n","        self.up2 = nn.ConvTranspose2d(\n","            base * 4,\n","            base * 2,\n","            kernel_size=2,\n","            stride=2,\n","        )\n","\n","        self.up1 = nn.ConvTranspose2d(\n","            base * 2,\n","            base,\n","            kernel_size=2,\n","            stride=2,\n","        )\n","\n","        if attention_mode == \"cross\":\n","            self.gate4 = AttentionGate(\n","                base * 8,\n","                base * 8,\n","                base * 4,\n","            )\n","\n","            self.gate3 = AttentionGate(\n","                base * 4,\n","                base * 4,\n","                base * 2,\n","            )\n","\n","            self.gate2 = AttentionGate(\n","                base * 2,\n","                base * 2,\n","                base,\n","            )\n","\n","            self.gate1 = AttentionGate(\n","                base,\n","      