ume.astype(np.float32)\n","\n","\n","def resize_volume_2d(volume_z_hw, mode):\n","    tensor = torch.from_numpy(\n","        volume_z_hw[:, None]\n","    ).float()\n","\n","    if mode == \"image\":\n","        resized = F.interpolate(\n","            tensor,\n","            size=(IMG_SIZE, IMG_SIZE),\n","            mode=\"bilinear\",\n","            align_corners=False,\n","        )\n","    else:\n","        resized = F.interpolate(\n","            tensor,\n","            size=(IMG_SIZE, IMG_SIZE),\n","            mode=\"nearest\",\n","        )\n","\n","    return resized.numpy()\n","\n","\n","def preprocess_patient(case_id):\n","    output_path = PROCESSED_DIR / f\"{case_id}.npz\"\n","\n","    if output_path.exists():\n","        return output_path\n","\n","    patient_dir = patient_dir_map[case_id]\n","\n","    flair_path = find_file(\n","        patient_dir,\n","        \"flair\",\n","    )\n","\n","    seg_path = find_file(\n","        patient_dir,\n","        \"seg\",\n","    )\n","\n","    flair = nib.load(\n","        str(flair_path)\n","    ).get_fdata(dtype=np.float32)\n","\n","    seg = nib.load(\n","        str(seg_path)\n","    ).get_fdata(dtype=np.float32)\n","\n","    flair = normalize_flair(\n","        flair\n","    )\n","\n","    mask = (\n","        seg > 0\n","    ).astype(np.uint8)\n","\n","    # Original BraTS shape is usually H, W, Z.\n","    # Convert it to Z, H, W for 2D slice training.\n","    flair_z_hw = np.transpose(\n","        flair,\n","        (2, 0, 1),\n","    )\n","\n","    mask_z_hw = np.transpose(\n","        mask,\n","        (2, 0, 1),\n","    )\n","\n","    images = resize_volume_2d(\n","        flair_z_hw,\n","        mode=\"image\",\n","    ).astype(np.float16)\n","\n","    masks = resize_volume_2d(\n","        mask_z_hw.astype(np.float32),\n","        mode=\"mask\",\n","    )\n","\n","    masks = (\n","        masks > 0.5\n","    ).astype(np.uint8)\n","\n","    tumor_slices = np.where(\n","        masks[:, 0].sum(axis=(